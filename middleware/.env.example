# Provider settings are read only by this server. Never copy AI_API_KEY to the Expo app.
AI_BASE_URL=https://ai.psu.blue/v1
AI_MODEL=openai/gpt-5.6-luna
AI_API_KEY=your-ai-api-key-here

# Supabase Auth is used to validate the Bearer token from the signed-in mobile app.
# This publishable key is allowed on clients, but keep this server configuration private.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Local development: keep localhost unless a physical device needs LAN access.
STUDY_API_HOST=127.0.0.1
STUDY_API_PORT=3001
AI_REQUEST_TIMEOUT_MS=90000

# Per signed-in user. Use production values in your Render environment settings.
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX_REQUESTS=40
