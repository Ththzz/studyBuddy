# Copy this file to .env.local and set the values needed for local development.
# EXPO_PUBLIC_* values are bundled into the mobile client and are readable by users.
# Never put service_role/private keys, passwords, access tokens, refresh tokens,
# API secrets, or other credentials in these variables.
# Keep privileged secrets in a trusted server-side function instead.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public address of the local Study Buddy middleware; this is not an API key.
# Android emulator: http://10.0.2.2:3001
# Physical device: use your computer's private LAN IP and bind the server to 0.0.0.0.
EXPO_PUBLIC_STUDY_API_URL=http://127.0.0.1:3001
